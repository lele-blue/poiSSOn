{
  "categories": [
    {
      "name": "PoiSSOn Core",
      "slug": "core",
      "icon": "cog",
      "pages": [
        {
          "name": "Your Instance",
          "header_text": "",
          "slug": "instance",
          "permissions": {
            "permissions": ["poison.instance.manage"]
          },
          "content": [
            {
              "name": "Instance Name",
              "type": "poisson.core_setting",
              "widget": "poisson.simple.input",
              "help_text": "This is the name that will be shown in the tab Title of your PoiSSOn instance<br>Additionally, this name will be used to identify your users across federation",
              "widget_data": {
                "input": {
                  "placeholder": "Instance Name"
                }
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.instance_name"
              }
            }
          ]
        },
        {
          "name": "Sessions",
          "header_text": "",
          "slug": "sessions",
          "content": [
            {
              "name": "Lifetime mode",
              "help_text": "When the session end condition is met, the master session is ended and the user has to reauthenticate (and re-validate the session using a second factor, if set up)",
              "type": "poisson.core_setting",
              "id": "poisson.core.session_lifetime.mode",
              "widget": "poisson.simple.choice",
              "widget_data": {
                "choices": [
                  {
                    "key": "poisson.session_lifetime.mode.inactivity",
                    "text": "End Session after an amount of Inactivity"
                  },
                  {
                    "key": "poisson.session_lifetime.mode.user_agent_close",
                    "text": "End Session after the user closes their browser"
                  },
                  {
                    "key": "poisson.session_lifetime.mode.fixed_after_login",
                    "text": "End Session after a fixed amount of time after login"
                  }
                ]
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.session_lifetime.mode"
              }
            },
            {
              "name": "Session Lifetime",
              "derived": true,
              "widget": "poisson.timedelta",
              "type": "poisson.core_setting",
              "condition": {
                "by_id": "poisson.core.session_lifetime.mode",
                "match": "poisson.session_lifetime.mode.fixed_after_login"
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.session_lifetime.value"
              }
            },
            {
              "name": "Inactivity Amount",
              "derived": true,
              "widget": "poisson.timedelta",
              "type": "poisson.core_setting",
              "condition": {
                "by_id": "poisson.core.session_lifetime.mode",
                "match": "poisson.session_lifetime.mode.inactivity"
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.session_lifetime.value"
              }
            },
            {
              "name": "Child Session Lifetime",
              "widget": "poisson.timedelta",
              "help_text": "A child session is created when the 'forward auth' authentication method is used cross-origin. Reauthentication will occur silently, so a short timeframe is recommended",
              "type": "poisson.core_setting",
              "type_data": {
                "poisson.core_setting.key": "poisson.core.child_session_lifetime.value"
              }
            }
          ]
        },
        {
          "name": "Webauthn",
          "header_text": "Webauthn/Passkeys can be configured here",
          "slug": "webauthn",
          "permissions": {
            "permissions": ["poisson.core.webauthn"]
          },
          "content": [
            {
              "name": "Authenticator Attachment Type",
              "help_text": "This setting controls what authenticators the browser will offer. <a href='https://www.w3.org/TR/webauthn-2/#enum-attachment' target='_blank'>More information</a>",
              "permissions": {
                "permissions": ["poisson.core/poisson.core.webauthn.authenticator_attachment"]
              },
              "type": "poisson.core_setting",
              "widget": "poisson.simple.choice",
              "widget_data": {
                "choices": [
                  {
                    "key": "poisson.core.webauthn.authenticator_attachment.none",
                    "text": "All Supported"
                  },
                  {
                    "key": "poisson.core.webauthn.authenticator_attachment.cross_platform",
                    "text": "Cross Platform"
                  },
                  {
                    "key": "poisson.core.webauthn.authenticator_attachment.platform",
                    "text": "Platform"
                  }
                ]
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.webauthn.authenticator_attachment"
              },
              "warn_if": [
                {"match": "poisson.core.webauthn.authenticator_attachment.cross_platform", "message": "This will prevent passkeys from working"},
                {"match": "poisson.core.webauthn.authenticator_attachment.platform", "message": "This will prevent hardware keys from working and enforce passkeys"}
              ]
            },
            {
              "name": "User Verification Requirement",
              "help_text": "This setting controls what authenticators the browser will offer. <a href='https://www.w3.org/TR/webauthn-2/#enum-userVerificationRequirement' target='_blank'>More information</a>",
              "permissions": {
                "permissions": ["poisson.core/poisson.core.webauthn.user_verification_requirement"]
              },
              "type": "poisson.core_setting",
              "widget": "poisson.simple.choice",
              "widget_data": {
                "choices": [
                  {
                    "key": "poisson.core.webauthn.user_verification_requirement.require",
                    "text": "Require Authentication"
                  },
                  {
                    "key": "poisson.core.webauthn.user_verification_requirement.prefer",
                    "text": "Prefer Authentication"
                  },
                  {
                    "key": "poisson.core.webauthn.user_verification_requirement.discourage",
                    "text": "Discourage Authentication"
                  }
                ]
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.webauthn.user_verification_requirement"
              },
              "warn_if": [
                {"match": "poisson.core.webauthn.user_verification_requirement.require", "message": "This may not consistently be available (e.g. if the laptop lid is closed or no fingerprints are set up)<br>If no verification was performed, authentication will fail silently with a generic error."}
              ]
            },
            {
              "name": "Authenticator Hint",
              "help_text": "This setting controls what authenticators the browser will offer first (if supported).<br/><br/><a href='https://developer.mozilla.org/en-US/docs/Web/API/PublicKeyCredentialCreationOptions#hints' target='_blank'>More information</a>",
              "permissions": {
                "permissions": ["poisson.core/poisson.core.webauthn.hint"]
              },
              "type": "poisson.core_setting",
              "widget": "poisson.simple.choice",
              "widget_data": {
                "choices": [
                  {
                    "key": "poisson.core.webauthn.hint.none",
                    "text": "No preference"
                  },
                  {
                    "key": "poisson.core.webauthn.hint.security_key",
                    "text": "Security Key"
                  },
                  {
                    "key": "poisson.core.webauthn.hint.client_device",
                    "text": "Client Device"
                  },
                  {
                    "key": "poisson.core.webauthn.hint.hybrid",
                    "text": "Hybrid"
                  }
                ]
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.webauthn.hint"
              }
            },
            {
              "name": "Resident Key Requirement",
              "help_text": "This setting controls what authenticators the browser will offer. <a href='https://www.w3.org/TR/webauthn-2/#enum-residentKeyRequirement' target='_blank'>More information</a>",
              "permissions": {
                "permissions": ["poisson.core/poisson.core.webauthn.resident_key_requirement"]
              },
              "type": "poisson.core_setting",
              "widget": "poisson.simple.choice",
              "widget_data": {
                "choices": [
                  {
                    "key": "poisson.core.webauthn.resident_key_requirement.require",
                    "text": "Require resident key"
                  },
                  {
                    "key": "poisson.core.webauthn.resident_key_requirement.prefer",
                    "text": "Prefer resident key"
                  },
                  {
                    "key": "poisson.core.webauthn.resident_key_requirement.discourage",
                    "text": "Discourage resident key"
                  }
                ]
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.webauthn.resident_key_requirement"
              },
              "warn_if": [
                {"match": "poisson.core.webauthn.resident_key_requirement.discourage", "message": "This will prevent passkeys from working"}
              ]
            }
          ]
        },
        {
          "name": "Theme",
          "header_text": "Customize your PoiSSOn instance",
          "slug": "theme",
          "permissions": {
            "permissions": ["poison.theme.manage"]
          },
          "content": [
            {
              "name": "Current Theme",
              "type": "poisson.core_setting",
              "widget": "poisson.custom.theme",
              "widget_data": null,
              "extended": true,
              "type_data": {
                "poisson.core_setting.key": "poisson.core.theme"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "slug": "users",
      "icon": "account",
      "pages": [
        {
          "name": "User Manager",
          "extra_data_depth": 2,
          "header_text": "Manage your Users",
          "slug": "manager",
          "permissions": {
            "permissions": ["poisson.users.manage"]
          },
          "subpages": {
            "*": {
              "name": "${user_title}",
              "header_text": "Edit User",
              "subpages": {
                "password_choose": {
                  "name": "Set Password",
                  "header_text":"",
                  "content": [
                    {
                      "name": "",
                      "extended": true,
                      "type": "poisson.user",
                      "widget": "poisson.choice.link",
                      "widget_data": {
                        "choices": [
                          {
                            "icon": "pencil",
                            "text": "Set Password"
                          },
                          {
                            "icon": "share",
                            "text": "Create reset link",
                            "call": "create_password_link"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              "content": [
                {
                  "name": null,
                  "widget": "poisson.context_group",
                  "type": "poisson.user",
                  "content": [
                    {
                      "group_key": "uid",
                      "name": "Actions",
                      "extended": true,
                      "widget": "poisson.choice.link"  ,
                      "condition": {
                        "call": "is_existing_user"
                      },
                      "widget_data": {
                        "choices": [
                          {
                            "icon": "key",
                            "text": "Set Password",
                            "path": "/auth/go/manager/[section]/[...data]",
                            "params": {
                              "section": "users",
                              "data": ["manager", "$val", "password_choose"]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "group_key": "username",
                      "name": "Username",
                      "condition": {
                        "call": "is_existing_user",
                        "invert": true
                      },
                      "help_text": "This can not be changed later",
                      "widget": "poisson.simple.input",
                      "widget_data": {
                        "input": {
                          "icon": "account",
                          "placeholder": "Username"
                        }
                      },
                      "warn_if": [
                      ]
                    },
                    {
                      "group_key": "first_name",
                      "name": "First Name",
                      "widget": "poisson.simple.input",
                      "widget_data": {
                        "input": {
                          "icon": "account",
                          "placeholder": "First Name"
                        }
                      },
                      "warn_if": [
                      ]
                    },
                    {
                      "group_key": "last_name",
                      "name": "Last Name",
                      "widget": "poisson.simple.input",
                      "widget_data": {
                        "input": {
                          "icon": "account",
                          "placeholder": "Last Name"
                        }
                      },
                      "warn_if": [
                      ]
                    },
                    {
                      "group_key": "email",
                      "name": "E-Mail",
                      "widget": "poisson.simple.input",
                      "widget_data": {
                        "input": {
                          "icon": "email",
                          "placeholder": "E-Mail"
                        }
                      },
                      "warn_if": [
                        {"call": "warn_email_direct"}
                      ]
                    },
                    {
                      "name": " ",
                      "extended": true,
                      "group_key": "uid",
                      "condition": {
                        "call": "is_existing_user",
                        "invert": true
                      },
                      "widget": "poisson.choice.link"  ,
                      "widget_data": {
                        "choices": [
                          {
                            "icon": "content-save",
                            "text": "Create",
                            "call": "save",
                            "mode": "replace",
                            "path": "/auth/go/manager/[section]/[...data]",
                            "params": {
                              "section": "users",
                              "data": ["manager", "$val"]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": "",
                      "extended": true,
                      "condition": {
                        "call": "is_existing_user"
                      },
                      "widget": "poisson.choice.link"  ,
                      "widget_data": {
                        "choices": [
                          {
                            "icon": "content-save",
                            "text": "Save",
                            "call": "save"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          },
          "content": [
            {
              "name": "Users",
              "help_text": "",
              "permissions": {
                "permissions": ["poisson.users.manage"]
              },
              "type": "poisson.users",
              "widget": "poisson.table",
              "extended": true,
              "widget_data": {
                "paginate": {
                  "per_page": 25
                },
                "no_data_text": "No User created yet. (That is weird, since you are a user)",
                "columns": [
                  {
                    "text": "Username",
                    "key": "username",
                    "icon": "user",
                    "can_sort": true,
                    "bold": true,
                    "link": {
                      "path": "/auth/go/manager/[section]/[...data]",
                      "params": {
                        "section": "users",
                        "data": ["manager", "${get_uid}"]
                      }
                    }
                  },
                  {
                    "text": "Full Name",
                    "key": "full_name",
                    "icon": "user",
                    "can_sort": true
                  },
                  {
                    "text": "Email",
                    "key": "email",
                    "icon": "email",
                    "can_sort": true,
                    "warn_if": "warn_email"
                  },
                  {
                    "text": "Actions",
                    "icon": "cog",
                    "column_role": "actions"
                  }
                ],
                "sort_by": null,
                "add_button": {
                  "enable": true,
                  "text": "Add User",
                  "action": "url",
                  "action_data": {
                    "path": "/auth/go/manager/[section]/[...data]",
                    "params": {
                      "section": "users",
                      "data": ["manager", "new"]
                    }
                  }
                },
                "actions": [
                  {
                    "button": {
                      "icon": "delete",
                      "destroy": true
                    },
                    "condition": "can_delete",
                    "text": "",
                    "action": "delete"
                  }
                ]
              },
              "type_data": {

              },
              "warn_if": [

              ]
            }
          ]
        },
        {
          "name": "Groups",
          "header_text": "Manage your Groups",
          "slug": "groups",
          "permissions": {
            "permissions": ["poisson.users.groups"]
          },
          "content": []
        }
      ]
    },
    {
      "name": "_OOBE",
      "slug": "oobe",
      "hidden": true,
      "pages": [
        {
          "name": "Hello from PoiSSOn",
          "header_text": "This is the first startup of PoiSSOn, so we need to set some things up. This wizard will guide you through the setup process in about 3 Minutes",
          "slug": "start",
          "content": [
            {
              "name": "",
              "widget": "poisson.custom.oobe_nav",
              "extended": true,
              "type": null,
              "widget_data": {
                "next": "admin"
              }
            }
          ]
        },
        {
          "name": "Setup an admin account",
          "header_text": "Please create a super-admin account",
          "slug": "admin",
          "content": [
            {
                "name": null,
                "widget": "poisson.context_group",
                "type": "poisson.oobe.admin_creation",
                "content": [
                  {
                    "group_key": "username",
                    "name": "Username",
                    "type": null,
                    "widget": "poisson.simple.input",
                    "warn_if": [
                      {"call": "warn_user_exists"},
                      {"call": "warn_username_empty"}
                    ],
                    "widget_data": {
                      "disabled_func": "disabled",
                      "input": {
                        "placeholder": "Username",
                        "autocomplete": "off"
                      }
                    }
                  },
                  {
                    "group_key": "password",
                    "name": "Password",
                    "type": null,
                    "widget": "poisson.simple.input",
                    "warn_if": [
                      {"call": "warn_user_exists"},
                      {"call": "warn_password"}
                    ],
                    "widget_data": {
                      "disabled_func": "disabled",
                      "input": {
                        "placeholder": "Password",
                        "password": true,
                        "autocomplete": "new-password"
                      }
                    }
                  },
                  {
                    "group_key": "password2",
                    "name": "Password (Again)",
                    "type": null,
                    "warn_if": [
                      {"call": "warn_user_exists"},
                      {"call": "warn_password2"}
                    ],
                    "widget": "poisson.simple.input",
                    "widget_data": {
                      "disabled_func": "disabled",
                      "input": {
                        "placeholder": "Password",
                        "password": true,
                        "autocomplete": "new-password"
                      }
                    }
                  },
                  {
                    "name": "",
                    "group_key": "_nav",
                    "type": null,
                    "widget": "poisson.custom.oobe_nav",
                    "extended": true,
                    "group_key": "username",
                    "widget_data": {
                      "pre_next": "verify_data_and_create",
                      "next": "instance_name",
                      "back": "start"
                    }
                  }
                ]
            }
          ]
        },
        {
          "name": "Choose a name for your instance",
          "header_text": "",
          "slug": "instance_name",
          "content": [
            {
              "name": "Instance Name",
              "type": "poisson.core_setting",
              "widget": "poisson.simple.input",
              "help_text": "This is the name that will be shown in the tab Title of your PoiSSOn instance<br>Additionally, this name will be used to identify your users across federation",
              "widget_data": {
                "input": {
                  "placeholder": "Instance Name"
                }
              },
              "type_data": {
                "poisson.core_setting.key": "poisson.core.instance_name"
              }
            },
            {
              "name": "",
              "widget": "poisson.custom.oobe_nav",
              "extended": true,
              "type": null,
              "widget_data": {
                "back": "admin",
                "next": "finish"
              }
            }
          ]
        },
        {
          "name": "That's it",
          "header_text": "Your PoiSSOn instance is now set up.",
          "slug": "finish",
          "content": [
            {
              "name": "",
              "widget": "poisson.custom.oobe_nav",
              "extended": true,
              "type": "poisson.oobe.finish",
              "widget_data": {
                "back": "instance_name",
                "pre_next": "finish",
                "next": "_"
              }
            }
          ]
        }
      ]
    }
  ]
}
